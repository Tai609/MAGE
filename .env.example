# Copy this file to .env and fill values locally.
# Never commit .env or paste credentials into issues, notebooks, or logs.

# Select one provider for each model role.
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Optional OpenAI-compatible gateway settings.
APIYI_API_KEY=
APIYI_BASE_URL=
OPENAI_API_BASE=

# Optional Azure PDF/Markdown preprocessing.
AZURE_API_KEY=
AZURE_API_ENDPOINT=

# Optional Neo4j graph import/query settings.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional resolver mappings (local paths only).
NAME_RESOLVER_REGEX_MAP=
FIELD_RESOLVER_REGEX_MAP=

# Optional runtime controls.
MAGE_LLM_ROUTE=extract
CATGRAPH_INVOKE_MAX_ATTEMPTS=2
CATGRAPH_INVOKE_RETRY_BACKOFF_SECONDS=0

